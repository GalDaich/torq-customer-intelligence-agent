# Server-only model configuration
OPENAI_API_KEY=
OPENAI_MODEL=

# Server-only research providers
TAVILY_API_KEY=
FIRECRAWL_API_KEY=

# Per-company LangSmith tracing
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=torq-customer-intelligence-agent
# This demo uses LangSmith's EU data plane. Use the endpoint for your workspace region.
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
# Serverless runtimes must finish trace callbacks before they can be suspended.
LANGCHAIN_CALLBACKS_BACKGROUND=false
LANGSMITH_TRACING_BACKGROUND=false
